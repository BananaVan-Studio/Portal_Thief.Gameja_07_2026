; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Portal Thief"
config/tags=PackedStringArray("bananavan_games", "gameja", "github", "group")
run/main_scene="res://menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bo0xbf6rvm5pj"

[autoload]

Events="*res://autoloads/events.gd"
Game="*res://autoloads/game.gd"
SceneManager="*res://autoloads/scene_manager.gd"
AudioManager="*res://autoloads/audio_manager.gd"

[display]

window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/simple_gdscript_formatter/plugin.cfg")

[file_customization]

folder_colors={
"res://UI/": "orange",
"res://autoloads/": "red",
"res://levels/": "yellow",
"res://menu/": "green",
"res://obstacles/": "purple",
"res://player/": "blue",
"res://thief/": "pink"
}

[global_group]

Player=""

